[
  {
    "id": 1,
    "image": "01-alfred-nobel-scene.png",
    "startToken": 0,
    "endToken": 16,
    "tokenCount": 17,
    "startMs": 60,
    "endMs": 4280,
    "startFrame": 2,
    "endFrame": 128,
    "text": "Alfred Nobel để lại di sản là giải thưởng danh giá nhất thế giới — giải Nobel."
  },
  {
    "id": 2,
    "image": "02-alfred-nobel-scene.png",
    "startToken": 17,
    "endToken": 51,
    "tokenCount": 35,
    "startMs": 4280,
    "endMs": 11910,
    "startFrame": 128,
    "endFrame": 357,
    "text": "Nhưng lý do ông lập ra giải thưởng đó lại bắt nguồn từ một trong những cú sốc kỳ lạ nhất lịch sử: ông từng đọc cáo phó của chính mình khi vẫn còn sống."
  },
  {
    "id": 3,
    "image": "03-alfred-nobel-scene.png",
    "startToken": 52,
    "endToken": 80,
    "tokenCount": 29,
    "startMs": 11910,
    "endMs": 20000,
    "startFrame": 357,
    "endFrame": 600,
    "text": "Chuyện là năm 1888, khi anh trai Alfred qua đời, một tờ báo Pháp nhầm lẫn và đăng nhầm cáo phó của Alfred Nobel thay vì anh trai ông."
  },
  {
    "id": 4,
    "image": "04-alfred-nobel-scene.png",
    "startToken": 81,
    "endToken": 94,
    "tokenCount": 14,
    "startMs": 20000,
    "endMs": 23030,
    "startFrame": 600,
    "endFrame": 691,
    "text": "Tiêu đề bài báo còn tệ hơn: 'Người buôn cái chết đã chết' —"
  },
  {
    "id": 5,
    "image": "05-alfred-nobel-scene.png",
    "startToken": 95,
    "endToken": 106,
    "tokenCount": 12,
    "startMs": 22880,
    "endMs": 25640,
    "startFrame": 686,
    "endFrame": 769,
    "text": "ám chỉ việc ông là người phát minh ra thuốc nổ dynamite,"
  },
  {
    "id": 6,
    "image": "06-alfred-nobel-scene.png",
    "startToken": 107,
    "endToken": 120,
    "tokenCount": 14,
    "startMs": 25640,
    "endMs": 28760,
    "startFrame": 769,
    "endFrame": 863,
    "text": "thứ đã giết chết hàng ngàn người trong chiến tranh và khai thác mỏ."
  },
  {
    "id": 7,
    "image": "07-alfred-nobel-scene.png",
    "startToken": 121,
    "endToken": 148,
    "tokenCount": 28,
    "startMs": 28760,
    "endMs": 34440,
    "startFrame": 863,
    "endFrame": 1033,
    "text": "Đọc chính cáo phó của mình, Nobel sốc nặng khi nhận ra thế giới sẽ nhớ đến ông chỉ như một kẻ buôn bán công cụ hủy diệt."
  },
  {
    "id": 8,
    "image": "08-alfred-nobel-scene.png",
    "startToken": 149,
    "endToken": 172,
    "tokenCount": 24,
    "startMs": 34440,
    "endMs": 38790,
    "startFrame": 1033,
    "endFrame": 1164,
    "text": "Ông quyết định phải làm gì đó để thay đổi cách người đời nhìn nhận về mình sau khi thực sự qua đời —"
  },
  {
    "id": 9,
    "image": "09-alfred-nobel-scene.png",
    "startToken": 173,
    "endToken": 183,
    "tokenCount": 11,
    "startMs": 38640,
    "endMs": 41200,
    "startFrame": 1159,
    "endFrame": 1236,
    "text": "và giải Nobel ra đời từ chính nỗi sợ hãi đó."
  },
  {
    "id": 10,
    "image": "10-alfred-nobel-scene.png",
    "startToken": 184,
    "endToken": 207,
    "tokenCount": 24,
    "startMs": 41200,
    "endMs": 47220,
    "startFrame": 1236,
    "endFrame": 1417,
    "text": "Nhưng đây mới là chi tiết trớ trêu nhất: Nobel giàu có nhờ phát minh ra dynamite, thứ vũ khí giết người hàng loạt,"
  },
  {
    "id": 11,
    "image": "11-alfred-nobel-scene.png",
    "startToken": 208,
    "endToken": 224,
    "tokenCount": 17,
    "startMs": 47220,
    "endMs": 50320,
    "startFrame": 1417,
    "endFrame": 1510,
    "text": "rồi dùng chính số tiền đó để lập ra giải thưởng tôn vinh hòa bình thế giới."
  },
  {
    "id": 12,
    "image": "12-alfred-nobel-scene.png",
    "startToken": 225,
    "endToken": 239,
    "tokenCount": 15,
    "startMs": 50320,
    "endMs": 54040,
    "startFrame": 1510,
    "endFrame": 1621,
    "text": "Nói cách khác, giải Nobel Hòa Bình được tài trợ bởi tiền bán thuốc nổ."
  },
  {
    "id": 13,
    "image": "13-alfred-nobel-scene.png",
    "startToken": 240,
    "endToken": 256,
    "tokenCount": 17,
    "startMs": 54040,
    "endMs": 58200,
    "startFrame": 1621,
    "endFrame": 1746,
    "text": "Về đời tư, Nobel sống gần như cô độc suốt đời, không kết hôn, không con cái,"
  },
  {
    "id": 14,
    "image": "14-alfred-nobel-scene.png",
    "startToken": 257,
    "endToken": 272,
    "tokenCount": 16,
    "startMs": 58200,
    "endMs": 61440,
    "startFrame": 1746,
    "endFrame": 1843,
    "text": "và dành phần lớn thời gian trong phòng thí nghiệm hơn là giao tiếp xã hội."
  },
  {
    "id": 15,
    "image": "15-alfred-nobel-scene.png",
    "startToken": 273,
    "endToken": 292,
    "tokenCount": 20,
    "startMs": 61440,
    "endMs": 65380,
    "startFrame": 1843,
    "endFrame": 1961,
    "text": "Ông từng viết trong một bức thư rằng bản thân cảm thấy mình là 'người bi quan nhất thế giới',"
  },
  {
    "id": 16,
    "image": "16-alfred-nobel-scene.png",
    "startToken": 293,
    "endToken": 307,
    "tokenCount": 15,
    "startMs": 65380,
    "endMs": 68840,
    "startFrame": 1961,
    "endFrame": 2065,
    "text": "dù sở hữu khối tài sản khổng lồ. Và một sự thật thú vị khác:"
  },
  {
    "id": 17,
    "image": "17-alfred-nobel-scene.png",
    "startToken": 308,
    "endToken": 322,
    "tokenCount": 15,
    "startMs": 68840,
    "endMs": 72210,
    "startFrame": 2065,
    "endFrame": 2166,
    "text": "giải Nobel không có hạng mục Toán học, dù có đến 6 lĩnh vực khác."
  },
  {
    "id": 18,
    "image": "18-alfred-nobel-scene.png",
    "startToken": 323,
    "endToken": 360,
    "tokenCount": 38,
    "startMs": 72210,
    "endMs": 80310,
    "startFrame": 2166,
    "endFrame": 2409,
    "text": "Có nhiều giả thuyết về lý do, một trong số đó — dù chưa được xác nhận chắc chắn — cho rằng Nobel từng có mâu thuẫn cá nhân với một nhà toán học nổi tiếng thời đó."
  },
  {
    "id": 19,
    "image": "19-alfred-nobel-scene.png",
    "startToken": 361,
    "endToken": 385,
    "tokenCount": 25,
    "startMs": 80310,
    "endMs": 85810,
    "startFrame": 2409,
    "endFrame": 2574,
    "text": "Người đàn ông phát minh ra thuốc nổ, đọc cáo phó của chính mình, rồi dùng cả gia tài để chuộc lại tên tuổi —"
  },
  {
    "id": 20,
    "image": "20-alfred-nobel-scene.png",
    "startToken": 386,
    "endToken": 390,
    "tokenCount": 5,
    "startMs": 85660,
    "endMs": 87320,
    "startFrame": 2570,
    "endFrame": 2620,
    "text": "đó chính là Alfred Nobel."
  }
]